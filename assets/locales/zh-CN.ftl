# 简体中文翻译（原型：主菜单）
# 键命名约定：kebab-case 纯标识符（FTL 键不能含点号，点号保留给属性访问），模块前缀用连字符
# 未命中键时回退到调用点提供的英文原文

app-menu-zoom-in = 放大
app-menu-zoom-out = 缩小
app-menu-reset-zoom = 重置缩放
app-menu-reset-all-zoom = 重置所有缩放
app-menu-toggle-left-dock = 切换左侧面板
app-menu-toggle-right-dock = 切换右侧面板
app-menu-toggle-bottom-dock = 切换底部面板
app-menu-toggle-all-docks = 切换所有面板
app-menu-settings = 设置
app-menu-open-settings = 打开设置
app-menu-toggle-language = 切换语言（i18n 演示）
